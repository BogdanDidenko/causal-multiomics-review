{
  "schema_version": "1.0.0",
  "suite_id": "causal_multiomics_screening",
  "suite_version": "0.2.0",
  "runtime": {
    "provider_protocol": "openai_compatible_vllm",
    "temperature": 0.7,
    "top_p": 1.0,
    "seed": 0,
    "n": 1,
    "context_window": 32768,
    "max_retries": 1,
    "response_format": "json_schema"
  },
  "stages": {
    "title_abstract": {
      "input_format": "csv",
      "max_tokens": 4000,
      "roles": {
        "scope_reviewer": {
          "prompt": "prompts/title_abstract/v0.2.0/scope_reviewer.txt",
          "schema": "schemas/title_abstract/v0.2.0/scope_reviewer.schema.json",
          "exclude_if": [
            {"field": "report_type", "in": ["review_editorial", "protocol", "methods_only", "resource"]},
            {"field": "bio_health_scope", "equals": "no"},
            {"field": "multiomics_status", "equals": "no"}
          ],
          "unclear_if": [
            {"field": "report_type", "equals": "unclear"},
            {"field": "bio_health_scope", "equals": "unclear"},
            {"field": "multiomics_status", "equals": "unclear"},
            {"field": "integration_mode", "equals": "unclear"}
          ]
        },
        "causal_design_reviewer": {
          "prompt": "prompts/title_abstract/v0.2.0/causal_design_reviewer.txt",
          "schema": "schemas/title_abstract/v0.2.0/causal_design_reviewer.schema.json",
          "exclude_if": [
            {"field": "identification_status", "in": ["association_only", "no_relevant_design"]}
          ],
          "unclear_if": [
            {"field": "identification_status", "equals": "unclear"}
          ]
        }
      },
      "adjudication": {
        "prompt": "prompts/title_abstract/v0.2.0/adjudicator.txt",
        "schema": "schemas/title_abstract/v0.2.0/adjudicator.schema.json",
        "exclude_if": [
          {"field": "report_type", "in": ["review_editorial", "protocol", "methods_only", "resource"]},
          {"field": "bio_health_scope", "equals": "no"},
          {"field": "multiomics_status", "equals": "no"},
          {"field": "identification_status", "in": ["association_only", "no_relevant_design"]}
        ],
        "unclear_if": [
          {"field": "report_type", "equals": "unclear"},
          {"field": "bio_health_scope", "equals": "unclear"},
          {"field": "multiomics_status", "equals": "unclear"},
          {"field": "identification_status", "equals": "unclear"}
        ]
      },
      "routing": {
        "round_a_all_include": "seek_full_text",
        "round_a_otherwise": "adjudicate",
        "adjudicated_include": "seek_full_text",
        "adjudicated_exclude": "exclude",
        "adjudicated_unclear": "seek_full_text"
      }
    },
    "full_text": {
      "input_format": "jsonl",
      "max_tokens": 16000,
      "section_selector": {
        "prompt": "prompts/full_text/v0.1.0/section_selector.txt",
        "schema": "schemas/full_text/v0.1.0/section_selector.schema.json"
      },
      "roles": {
        "eligibility_reviewer": {
          "prompt": "prompts/full_text/v0.1.0/eligibility_reviewer.txt",
          "schema": "schemas/full_text/v0.1.0/eligibility_reviewer.schema.json",
          "exclude_if": [
            {"field": "empirical_primary", "equals": "no"},
            {"field": "bio_health_scope", "equals": "no"},
            {"field": "multiomics_status", "equals": "no"},
            {"field": "date_eligible", "equals": "no"},
            {"field": "english_language", "equals": "no"}
          ],
          "unclear_if": [
            {"field": "empirical_primary", "equals": "unclear"},
            {"field": "bio_health_scope", "equals": "unclear"},
            {"field": "multiomics_status", "equals": "unclear"},
            {"field": "date_eligible", "equals": "unclear"},
            {"field": "english_language", "equals": "unclear"},
            {"field": "full_text_sufficient", "in": ["no", "unclear"]}
          ]
        },
        "causal_evidence_reviewer": {
          "prompt": "prompts/full_text/v0.1.0/causal_evidence_reviewer.txt",
          "schema": "schemas/full_text/v0.1.0/causal_evidence_reviewer.schema.json",
          "exclude_if": [
            {"field": "identification_status", "in": ["association_only", "not_applicable"]}
          ],
          "unclear_if": [
            {"field": "identification_status", "equals": "unclear"},
            {"field": "estimand_complete", "equals": "unclear"},
            {"field": "assumptions_assessable", "equals": "unclear"},
            {"field": "validation_strength", "equals": "unclear"}
          ]
        }
      },
      "adjudication": {
        "prompt": "prompts/full_text/v0.1.0/adjudicator.txt",
        "schema": "schemas/full_text/v0.1.0/adjudicator.schema.json",
        "exclude_if": [
          {"field": "empirical_primary", "equals": "no"},
          {"field": "bio_health_scope", "equals": "no"},
          {"field": "multiomics_status", "equals": "no"},
          {"field": "date_eligible", "equals": "no"},
          {"field": "english_language", "equals": "no"},
          {"field": "identification_status", "in": ["association_only", "not_applicable"]}
        ],
        "unclear_if": [
          {"field": "empirical_primary", "equals": "unclear"},
          {"field": "bio_health_scope", "equals": "unclear"},
          {"field": "multiomics_status", "equals": "unclear"},
          {"field": "full_text_sufficient", "in": ["no", "unclear"]},
          {"field": "identification_status", "equals": "unclear"},
          {"field": "estimand_complete", "equals": "unclear"},
          {"field": "assumptions_assessable", "equals": "unclear"},
          {"field": "validation_strength", "equals": "unclear"}
        ]
      },
      "routing": {
        "round_a_all_include": "assessed",
        "round_a_otherwise": "adjudicate",
        "adjudicated_include": "assessed",
        "adjudicated_exclude": "assessed",
        "adjudicated_unclear": "manual_review"
      }
    }
  },
  "evidence_level_rules": {
    "analytic_levels": [2, 3, 4],
    "labels": {
      "0": "context_only",
      "1": "associational",
      "2": "causal_hypothesis",
      "3": "causal_evidence",
      "4": "causal_evidence"
    }
  },
  "run_matrix": {
    "prompt_regression": [
      {"model": "deepseek-v4-flash", "repeats": 3},
      {"model": "gpt-oss-120b", "repeats": 2}
    ],
    "full_deployment": [
      {"model": "deepseek-v4-flash", "repeats": 2},
      {"model": "gpt-oss-120b", "repeats": 2},
      {"model": "nemotron3-super-120b-a12b-fp8", "repeats": 2}
    ]
  },
  "ensemble_policy": {
    "models": ["deepseek-v4-flash", "gpt-oss-120b", "nemotron3-super-120b-a12b-fp8"],
    "full_corpus_repeats_per_model": 2,
    "automatic_exclusion": "all_six_exclude_with_same_exclusion_code",
    "otherwise": "seek_full_text"
  }
}
