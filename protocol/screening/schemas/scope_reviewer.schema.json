{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["paper_type", "bio_health_scope", "multiomics_present", "omics_layers", "report_level_multiomics_evidence", "primary_exclusion_code", "uncertainty_reason", "rationale"],
  "properties": {
    "paper_type": {"enum": ["empirical_primary", "review_editorial", "protocol", "methods_only", "resource", "unclear"]},
    "bio_health_scope": {"enum": ["yes", "no", "unclear"]},
    "multiomics_present": {"enum": ["yes", "no", "unclear"]},
    "omics_layers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "report_level_multiomics_evidence": {"type": "string"},
    "primary_exclusion_code": {"enum": ["EC1", "EC2", "EC3", "EC4", "none", "unclear"]},
    "uncertainty_reason": {"type": "string"},
    "rationale": {"type": "string"}
  }
}
