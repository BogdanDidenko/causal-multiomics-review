{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "causal_claim_present",
    "identification_status",
    "design_families",
    "design_role",
    "exposure_or_intervention",
    "comparator",
    "outcome",
    "estimand_or_contrast",
    "evidence_spans",
    "boundary_case",
    "uncertainty_reason",
    "concise_rationale"
  ],
  "properties": {
    "causal_claim_present": {"enum": ["yes", "no", "unclear"]},
    "identification_status": {
      "enum": ["identified", "hypothesis_only", "association_only", "no_relevant_design", "unclear"]
    },
    "design_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/design_family"}
    },
    "design_role": {
      "enum": ["primary_identification", "supporting_identification", "hypothesis_generation", "validation_only", "mentioned_only", "unclear"]
    },
    "exposure_or_intervention": {"type": "string"},
    "comparator": {"type": "string"},
    "outcome": {"type": "string"},
    "estimand_or_contrast": {"type": "string"},
    "evidence_spans": {
      "type": "array",
      "items": {"$ref": "#/$defs/title_abstract_evidence"}
    },
    "boundary_case": {
      "enum": [
        "clear_identified",
        "thin_abstract",
        "causal_wording_only",
        "prediction_or_association_only",
        "colocalization_only",
        "network_or_direction_only",
        "rct_without_mediation_identification",
        "uncontrolled_mediation",
        "perturbation_scope_mismatch",
        "other",
        "none"
      ]
    },
    "uncertainty_reason": {"type": "string"},
    "concise_rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "design_family": {
      "enum": [
        "genetic_instrument",
        "randomized_intervention",
        "nonrandomized_intervention",
        "direct_perturbation",
        "temporal_design",
        "formal_mediation",
        "graphical_or_directed_model",
        "other"
      ]
    },
    "title_abstract_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "source", "quote"],
      "properties": {
        "criterion": {
          "enum": [
            "causal_claim_present",
            "identification_status",
            "design_family",
            "design_role",
            "exposure_or_intervention",
            "outcome",
            "estimand_or_contrast"
          ]
        },
        "source": {"enum": ["title", "abstract", "metadata"]},
        "quote": {"type": "string", "minLength": 1}
      }
    }
  }
}
